# Mac
.DS_Store

# Linux
*~

# Rider Link
Plugins/Developer/RiderLink/

# Unreal Engine cache
DerivedDataCache/
Engine/DerivedDataCache/

# Optional: Ignore marketplace plugins binaries
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Keep plugin source/config/content
!Plugins/*/Source/
!Plugins/*/Content/
!Plugins/*/Config/

# Ignore local environment files
.env

# Ignore temporary files
*.tmp
*.temp

# Ignore profiling/debugging
*.psess
*.vsp
*.vspx
*.sap

# Ignore HLOD / generated assets
*_BuiltData.uasset

# Ignore test reports
TestResults/

# Keep important UE folders
!Source/
!Config/
!Content/
!Plugins/

# Git LFS recommendation for large assets
# *.uasset filter=lfs diff=lfs merge=lfs -text
